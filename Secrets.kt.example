package com.omer.qaygisiz

// Copy this file to Secrets.kt and fill in the values you have.
// Secrets.kt is in .gitignore and must never be committed.
//
// Every value may be left as an empty string. The app's setup screen
// can supply the Telegram token, the chat ID, the protected person and
// the language at runtime; whatever the user enters there wins over
// what is written here.
//
// The two model keys are not exposed in the UI, because they belong to
// whoever builds the app, not to the person using it. Leaving them empty
// simply means the alert arrives without the AI explanation.

object Secrets {

    // Telegram bot token from @BotFather
    const val TELEGRAM_BOT_TOKEN = ""

    // Chat ID of the family member who receives the warnings
    const val TELEGRAM_CHAT_ID = ""

    // https://openrouter.ai/keys  (free tier)
    const val OPENROUTER_API_KEY = ""

    // https://aistudio.google.com/apikey  (fallback, free tier)
    const val GEMINI_API_KEY = ""

    // Default language: "az", "en" or "ru"
    const val LANGUAGE = "az"

    // How the protected person is referred to in the warning,
    // e.g. "Atam". Empty falls back to "yaxininiz" / "your relative".
    const val PROTECTED_PERSON = ""
}
